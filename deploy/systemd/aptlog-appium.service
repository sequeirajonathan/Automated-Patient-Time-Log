[Unit]
# StartLimitIntervalSec belongs in [Unit]. It sat in [Service] in every unit
# here, where systemd ignores it with a warning nobody was reading -- so the
# protection OPERATIONS.md section 1.2 describes was never actually in place.
# Restart=always with the default limit gives up after 5 starts in 10s and
# leaves the unit failed, with nobody in the building to clear it.
StartLimitIntervalSec=0
Description=Appium server (drives the Android phone over adb)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apt
# appium-uiautomator2-driver refuses to create ANY session without an SDK root,
# failing with "Neither ANDROID_HOME nor ANDROID_SDK_ROOT environment variable
# was exported". Debian's adb package already ships the layout it wants, at
# /usr/lib/android-sdk/platform-tools/adb -- it just has to be pointed at.
# Without these two lines the agent cannot drive the phone at all.
Environment=ANDROID_HOME=/usr/lib/android-sdk
Environment=ANDROID_SDK_ROOT=/usr/lib/android-sdk
# The adb server this unit starts presents the ONE key the phone authorized,
# whoever else ever starts one. Losing that identity mid-visit meant a human
# tapping "Allow USB debugging" with a patient waiting — never again. See
# scripts/adb-identity.sh (vault + restore + system-wide export).
Environment=ADB_VENDOR_KEYS=/home/apt/.android/adbkey
ExecStartPre=/usr/bin/adb start-server
ExecStart=/usr/bin/appium --address 127.0.0.1 --port 4723 --log-timestamp
Restart=always
RestartSec=10
# Never give up: an unattended box has nobody to clear a failed unit.

[Install]
WantedBy=multi-user.target
