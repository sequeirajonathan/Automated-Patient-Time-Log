[Unit]
Description=APT Log status UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apt
WorkingDirectory=/opt/aptlog
# Bound to the Tailscale interface only — never 0.0.0.0. The building LAN is
# shared with residents, and this page shows visit state.
ExecStart=/opt/aptlog/.venv/bin/uvicorn apt_log.ui:app --host 100.64.0.0 --port 8080
Restart=always
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
