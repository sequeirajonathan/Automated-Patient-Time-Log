[Unit]
# StartLimitIntervalSec belongs in [Unit]. It sat in [Service] in every unit
# here, where systemd ignores it with a warning nobody was reading -- so the
# protection OPERATIONS.md section 1.2 describes was never actually in place.
# Restart=always with the default limit gives up after 5 starts in 10s and
# leaves the unit failed, with nobody in the building to clear it.
StartLimitIntervalSec=0
Description=APT Log status UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apt
WorkingDirectory=/opt/aptlog
# Loopback only — never 0.0.0.0. The building LAN is shared with other residents
# and this page shows visit state. `tailscale serve` proxies to this port and is
# what publishes it to the tailnet, so binding an interface here is unnecessary
# and would be guessing at an address that can change.
ExecStart=/opt/aptlog/.venv/bin/uvicorn apt_log.ui:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
